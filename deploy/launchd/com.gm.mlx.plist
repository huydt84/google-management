<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- mlx-server-runtime serving the model on 127.0.0.1:8000. Not kept alive: with the dashboard's
     "Load/unload by gm" switch on, gm's residency controller starts it at GM_MODEL_ON (launchctl
     kickstart) and stops it at GM_MODEL_OFF (launchctl kill TERM), and reconciles every 10 minutes
     (ADR-0010, decision N10). With the switch off it starts at login and runs until stopped; gm
     still defers model work outside model hours. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gm.mlx</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/mlx-air</string>
    <string>serve</string>
    <string>--model</string>
    <string>mlx-community/Qwen3-8B-4bit</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/gm/mlx.stderr.log</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/gm/mlx.stdout.log</string>
</dict>
</plist>
