<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- mlx-server-runtime serving the summary model on 127.0.0.1:8000. Model hours (09:00-19:00) are
     enforced by gm deferring work; the residency controller that starts/stops this agent comes in
     Phase 2 (ADR-0010). Until then it simply stays up. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gm.mlx</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/mlx-air</string>
    <string>serve</string>
    <string>--model</string>
    <string>mlx-community/Qwen3-8B-4bit</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/gm/mlx.stderr.log</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/gm/mlx.stdout.log</string>
</dict>
</plist>
