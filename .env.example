# Non-secret configuration. Copy to .env. Secrets live in the macOS Keychain (ADR-0013):
#   gm gen-key                           # random 32-byte key (run once per key)
#   gm keychain set master-key           # encrypts Google refresh tokens
#   gm keychain set session-secret       # signs login cookies
#   gm keychain set google-client-secret
#   gm keychain set telegram-bot-token   # optional; without it notifications are only logged
#   gm keychain set metrics-token        # optional; enables /metrics
# In CI/tests the same secrets can come from GM_SECRET_<NAME> (e.g. GM_SECRET_MASTER_KEY).

# The only Google account allowed to log in
GM_ALLOWED_EMAIL=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URIs:
#   http://localhost:8080/auth/callback
#   http://localhost:8080/connect/google/callback
GM_GOOGLE_CLIENT_ID=

# gm binds loopback only. Remote access is through `tailscale serve`; put the tailnet URL here.
GM_PORT=8080
GM_BASE_URL=http://localhost:8080
# GM_PUBLIC_URL=https://your-mac.your-tailnet.ts.net
GM_DATABASE_URL=postgres://gm:gm@127.0.0.1:5433/gm

# Gmail ingestion (ADR-0002). pubsub: Gmail pushes to a Pub/Sub topic that gm pulls;
# gm creates the topic, subscription and publish permission itself in this project (enable the
# Cloud Pub/Sub API there first). A safety poll runs every 15 min, or every 60 s while Pub/Sub is down.
GM_GMAIL_INGEST_MODE=pubsub
GM_GOOGLE_PROJECT_ID=your-project-id
# GM_GMAIL_PUBSUB_TOPIC=gm-gmail
# GM_GMAIL_PUBSUB_SUBSCRIPTION=gm-gmail-pull
GM_GMAIL_SAFETY_POLL_INTERVAL_S=900
GM_GMAIL_POLL_INTERVAL_S=60
GM_GMAIL_LABEL_IDS=INBOX
GM_RULES_PATH=rules.yaml

# Local model via mlx-server-runtime (ADR-0010, ADR-0011). See ADR-0011 for evaluating Bonsai-27B.
GM_LLM_BASE_URL=http://127.0.0.1:8000/v1
GM_LLM_MODEL=mlx-community/Qwen3-8B-4bit
# For Bonsai direct mode, use the path printed by scripts/prepare-bonsai-direct.py.
GM_LLM_TIMEOUT_S=120
# Readiness probe for the model_down health check (default: base URL without /v1, plus /ready)
# GM_LLM_READY_URL=http://127.0.0.1:8000/ready
GM_LLM_MAX_INFLIGHT=2
GM_LLM_MAX_INPUT_TOKENS=2000
GM_LLM_SUMMARY_MAX_TOKENS=400
# Per-model sampling overrides (ADR-0018).
# GM_LLM_PROFILE=llm.yaml

# Model hours (local time). Outside them, and while the model is unavailable, summaries wait; only
# rule-only notifications go out. Queued summaries retry every GM_LLM_UNAVAILABLE_RETRY_S seconds.
GM_MODEL_ON=09:00
GM_MODEL_OFF=19:00
# Default morning digest time (each user can change it in Settings, inside model hours)
GM_DIGEST_AT=09:05
GM_LLM_UNAVAILABLE_RETRY_S=300
# gm stops the model outside model hours and starts it for your Telegram / web requests (it calls
# the mlx-air CLI; mlx-air runs the process). First defaults: the dashboard values win once saved.
GM_MODEL_MANAGE=true
# GM_MODEL_IDLE_MIN=10         minutes the model stays up after your last request outside model hours
# GM_MODEL_STOP_GRACE_S=300    wait for in-flight requests before stopping
# GM_MODEL_START_TIMEOUT_S=120 wait for /ready after starting
# GM_MLX_AIR_BIN=              default: ~/.local/bin/mlx-air if it exists, else mlx-air
# GM_MLX_INSTANCE=gm
# Local eval set (raw mails, mode 0700, never committed; see ADR-0017)
# GM_EVAL_DIR=~/.local/share/gm/eval

# Defaults for users who haven't saved Settings yet
GM_DEFAULT_SUMMARY_LANGUAGE=Vietnamese
GM_DEFAULT_UI_LANGUAGE=en

# Telegram: create a bot with @BotFather, message it, then read your chat id from getUpdates
# (before gm runs: gm long-polls getUpdates itself and only answers this chat).
GM_TELEGRAM_CHAT_ID=

# Workers and housekeeping
GM_WORKER_CONCURRENCY=2
GM_JOB_MAX_ATTEMPTS=5
GM_RETENTION_DAYS=60

# Phase 3: hours before a proposed action (Approve / Reject in Telegram or on /tasks) expires
GM_APPROVAL_TTL_H=24
# GM_LOG_DIR=~/Library/Logs/gm   (set by the launchd plist)

# Calendar read-only API endpoint. The owner reconnects Google to grant calendar.readonly.
GM_CALENDAR_API_BASE=https://www.googleapis.com/calendar/v3
