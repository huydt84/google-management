# Copy to .env and fill in. Generate the two secrets with: uv run gm gen-keys
GM_SESSION_SECRET=
GM_ENCRYPTION_KEY=

# The only Google account allowed to log in
GM_ALLOWED_EMAIL=you@gmail.com

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URIs:
#   http://localhost:8080/auth/callback
#   http://localhost:8080/connect/google/callback
GM_GOOGLE_CLIENT_ID=
GM_GOOGLE_CLIENT_SECRET=

GM_BASE_URL=http://localhost:8080
GM_DATABASE_URL=postgresql+asyncpg://gm:gm@localhost:5433/gm

# poll (no Pub/Sub setup needed) | pubsub
GM_GMAIL_INGEST_MODE=poll
GM_GMAIL_POLL_INTERVAL_S=60
# pubsub mode only:
# GM_GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/gmail-events
# GM_GMAIL_PUBSUB_SUBSCRIPTION=projects/<project-id>/subscriptions/gm-pull

# OpenAI-compatible LLM endpoint (mlx-server-runtime gateway; LiteLLM later)
GM_LLM_BASE_URL=http://127.0.0.1:8000/v1
GM_LLM_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
GM_SUMMARY_LANGUAGE=Vietnamese

# Telegram: create a bot with @BotFather, send it a message, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates. Leave empty to log notifications only.
GM_TELEGRAM_BOT_TOKEN=
GM_TELEGRAM_CHAT_ID=
